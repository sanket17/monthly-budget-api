# Install on the VM with: crontab -e   (adjust APP path). Times are UTC.
APP=/opt/budget
COMPOSE=docker compose -f /opt/budget/docker-compose.prod.yml

# Generate due recurring entries (idempotent; per-user timezone aware).
# Also keeps the Supabase free project from being paused for inactivity.
5 */6 * * *  cd $APP && $COMPOSE run --rm -T web python manage.py generate_recurring_transactions >> /var/log/budget-cron.log 2>&1

# Purge expired JWT blacklist rows weekly (keeps the 500 MB free DB small).
30 3 * * 0   cd $APP && $COMPOSE run --rm -T web python manage.py flushexpiredtokens >> /var/log/budget-cron.log 2>&1

# Nightly logical backup (Supabase free has no downloadable backups).
15 2 * * *   $APP/deploy/backup.sh >> /var/log/budget-cron.log 2>&1
