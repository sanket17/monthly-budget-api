# Copy to .env on the server (chmod 600). Never commit the real file.

# python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=change-me

# Public hostname Caddy serves and gets a certificate for. DNS must point here.
DOMAIN=api.example.com
ALLOWED_HOSTS=api.example.com

# Web app origin(s) allowed to call the API, comma separated, with scheme.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Supabase: Connect -> "Session pooler" string (IPv4-compatible, port 5432).
# URL-encode special characters in the password (@ -> %40, / -> %2F, ...).
DATABASE_URL=postgres://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: raise to 31536000 once HTTPS works on the final domain.
# SECURE_HSTS_SECONDS=3600
